rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // System initialization flag
    match /system/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Pesantren Profile
    match /pesantrenProfile/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId);
      allow delete: if isValidId(docId);
    }

    // Settings & Security
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId);
      allow delete: if isValidId(docId);
    }

    // Academic Terms
    match /academicTerms/{termId} {
      allow read: if true;
      allow create, update: if isValidId(termId);
      allow delete: if isValidId(termId);
    }

    // Petinggi Pesantren
    match /petinggi/{petinggiId} {
      allow read: if true;
      allow create, update: if isValidId(petinggiId);
      allow delete: if isValidId(petinggiId);
    }

    // Panitia Ujian
    match /panitiaUjian/{panitiaId} {
      allow read: if true;
      allow create, update: if isValidId(panitiaId);
      allow delete: if isValidId(panitiaId);
    }

    // Mata Pelajaran
    match /mataPelajaran/{mapelId} {
      allow read: if true;
      allow create, update: if isValidId(mapelId);
      allow delete: if isValidId(mapelId);
    }

    // Kelas
    match /kelas/{kelasId} {
      allow read: if true;
      allow create, update: if isValidId(kelasId);
      allow delete: if isValidId(kelasId);
    }

    // Santri
    match /santri/{santriId} {
      allow read: if true;
      allow create, update: if isValidId(santriId);
      allow delete: if isValidId(santriId);
    }

    // Asatidz
    match /asatidz/{asatidzId} {
      allow read: if true;
      allow create, update: if isValidId(asatidzId);
      allow delete: if isValidId(asatidzId);
    }

    // Nilai Santri
    match /nilaiSantri/{nilaiId} {
      allow read: if true;
      allow create, update: if isValidId(nilaiId);
      allow delete: if isValidId(nilaiId);
    }

    // Jadwal Ujian
    match /jadwalUjian/{jadwalId} {
      allow read: if true;
      allow create, update: if isValidId(jadwalId);
      allow delete: if isValidId(jadwalId);
    }

    // Pengumuman
    match /pengumuman/{pengumumanId} {
      allow read: if true;
      allow create, update: if isValidId(pengumumanId);
      allow delete: if isValidId(pengumumanId);
    }

    // Tugas Mengajar
    match /tugasMengajar/{tugasId} {
      allow read: if true;
      allow create, update: if isValidId(tugasId);
      allow delete: if isValidId(tugasId);
    }

    // Admin Users
    match /adminUsers/{adminId} {
      allow read: if true;
      allow create, update: if isValidId(adminId);
      allow delete: if isValidId(adminId);
    }
  }
}
